# Local PostgreSQL and separate Redis cache/broker.
DATABASE_URL=postgresql+asyncpg://gather:gather_local@localhost:5432/gather
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6380/0
AUTH_ORIGIN=http://localhost:3000
AUTH_COOKIE_SECURE=false

# Local Mailpit. Replace with a verified SMTP provider when deploying.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=Gather <noreply@gather.local>

# Local S3-compatible storage; replace with your hosted bucket configuration.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=gather_local
STORAGE_SECRET_KEY=gather_local_storage_secret
STORAGE_BUCKET=gather-media
MEDIA_PUBLIC_URL=http://localhost:9000/gather-media

# Optional Cashfree sandbox only. Add real credentials only to ignored .env.
CASHFREE_ENABLED=false
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_API_VERSION=2026-01-01
CASHFREE_NOTIFY_URL=
